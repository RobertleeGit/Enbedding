--cpu=Cortex-M4.fp.sp
"led_init\startup_stm32f411xe.o"
"led_init\main.o"
"led_init\gpio.o"
"led_init\stm32f4xx_it.o"
"led_init\stm32f4xx_hal_msp.o"
"led_init\stm32f4xx_hal_tim.o"
"led_init\stm32f4xx_hal_tim_ex.o"
"led_init\stm32f4xx_hal_rcc.o"
"led_init\stm32f4xx_hal_rcc_ex.o"
"led_init\stm32f4xx_hal_flash.o"
"led_init\stm32f4xx_hal_flash_ex.o"
"led_init\stm32f4xx_hal_flash_ramfunc.o"
"led_init\stm32f4xx_hal_gpio.o"
"led_init\stm32f4xx_hal_dma_ex.o"
"led_init\stm32f4xx_hal_dma.o"
"led_init\stm32f4xx_hal_pwr.o"
"led_init\stm32f4xx_hal_pwr_ex.o"
"led_init\stm32f4xx_hal_cortex.o"
"led_init\stm32f4xx_hal.o"
"led_init\stm32f4xx_hal_exti.o"
"led_init\system_stm32f4xx.o"
--strict --scatter "LED_Init\LED_Init.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "LED_Init.map" -o LED_Init\LED_Init.axf